# LinguaTaste Environment Variables Template
# Copy this file to .env.local (or .env) and populate your own API keys.
# NEVER commit real secret credentials or .env.local to Git.

# ─── Required for Live Taste Graph Intelligence ──────────────────────────────
# Qloo API Key (Hackathon access or standard API access)
# Header used: X-Api-Key: <your-key>
# Target endpoint: https://hackathon.api.qloo.com (or https://api.qloo.com)
QLOO_API_KEY=your_qloo_api_key_here

# Optional: Override Qloo base URL if not using hackathon.api.qloo.com
# QLOO_BASE_URL=https://hackathon.api.qloo.com

# ─── Recommended for Film/TV Posters & JustWatch Streaming Availability ─────
# TMDB API Read Access Token (v4 Bearer token, starts with eyJ...)
# OR standard v3 API Key (32-character hex key)
# The application automatically detects whether you provided a v4 Bearer token or a v3 API key.
TMDB_API_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here
# TMDB_API_KEY=your_tmdb_v3_api_key_here

# ─── Optional Pedagogical Scoring & Explanations ────────────────────────────
# Anthropic API Key (Claude 3.5 Sonnet / Haiku for linguistic analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Optional Streaming & Music Upgrades ────────────────────────────────────
# Watchmode API key (upgrades film/TV availability to Tier 1 direct platform deep links)
# WATCHMODE_API_KEY=your_watchmode_api_key_here

# Spotify Developer credentials (upgrades music recommendations to direct Spotify links)
# SPOTIFY_CLIENT_ID=your_spotify_client_id_here
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
